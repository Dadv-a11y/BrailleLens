<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryPressed">#1D4ED8</Color>
    <Color x:Key="PrimarySoft">#EAF1FD</Color>
    <Color x:Key="PrimarySoftPressed">#D6E4FB</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>

    <Color x:Key="Background">#F6F8FB</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Border">#E2E8F0</Color>
    <Color x:Key="DotInactive">#CBD5E1</Color>
    <Color x:Key="Overlay">#800F172A</Color>

    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextDisabled">#94A3B8</Color>

    <Color x:Key="Success">#15803D</Color>
    <Color x:Key="SuccessSoft">#F0FDF4</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="ErrorSoft">#FEF2F2</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />

</ResourceDictionary>
